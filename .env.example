# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Sarvam AI Credentials (STT: Saaras v3, TTS: Bulbul v2/v3)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM BYOK (Optional: Supports Gemini, OpenAI, Anthropic, or default Smart Mock)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
